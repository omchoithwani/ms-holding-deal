HUBSPOT_ACCESS_TOKEN=        # MS Holdings Private App token (scopes: crm.objects.contacts.read, crm.objects.companies.read, crm.objects.owners.read; tasks/notes are covered by the contact/company read scopes)
HUBSPOT_OWNER_IDS=160966942  # Comma-separated HubSpot owner IDs. 160966942 = Edward Sarkisyan
HUBSPOT_PORTAL_ID=244458981  # MS Holdings portal
HUBSPOT_UI_DOMAIN=app-na2.hubspot.com  # MS Holdings is on the na2 data center
RESEND_API_KEY=              # Resend API key
FROM_EMAIL=                  # Verified Resend sender, e.g. reports@yourdomain.com
RECIPIENT_EMAILS=            # Comma-separated: edward@mshlds.com,...
NOTES_LIMIT=3                # Number of latest notes per task
INCLUDE_OVERDUE=true         # Include the "Overdue & still open" section
# Optional one-off range (YYYY-MM-DD). Both must be set.
DATE_FROM=
DATE_TO=
# DRY_RUN=true writes digest-preview.html and prints the email instead of sending
DRY_RUN=
